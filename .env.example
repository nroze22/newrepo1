# ============================================================================
# AI Consultant Platform - Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# Gemini API Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro-latest

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Generate secure key: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=your_secret_key_here_change_in_production
ENVIRONMENT=development  # development, staging, production
DEBUG=false

# ----------------------------------------------------------------------------
# Analysis Settings
# ----------------------------------------------------------------------------
FRAMES_PER_ANALYSIS=30           # Analyze every N frames (higher = lower cost, less frequent insights)
MAX_SESSION_DURATION=3600        # Maximum session duration in seconds
ENABLE_CACHE=true                # Enable response caching for cost savings
CACHE_TTL=300                    # Cache time-to-live in seconds

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30         # Max requests per minute per IP
RATE_LIMIT_PER_HOUR=500          # Max requests per hour per IP

# ----------------------------------------------------------------------------
# Redis Configuration (Optional - for distributed caching/rate limiting)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ----------------------------------------------------------------------------
# Stripe Payment Configuration (Optional)
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# ----------------------------------------------------------------------------
# Monitoring & Error Tracking (Optional)
# ----------------------------------------------------------------------------
# Sentry DSN for error tracking: https://sentry.io
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENABLED=false

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins, or * for all (NOT recommended in production)
CORS_ORIGINS=*

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json                  # json or text

# ----------------------------------------------------------------------------
# WebSocket Configuration
# ----------------------------------------------------------------------------
WS_HEARTBEAT_INTERVAL=30         # WebSocket heartbeat interval in seconds
WS_MESSAGE_SIZE_LIMIT=10485760   # Max WebSocket message size in bytes (10MB)
